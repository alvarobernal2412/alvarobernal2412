---
export interface Props {
  title: string;
  lang?: string;
}

const { title, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --accent: #1e40af;
    --accent-2: #0ea5e9;
    --background: #f8fafc;
    --surface: #ffffff;
    --surface-alt: #f1f5f9;
    --text-primary: #0f172a;
    --text-strong: #334155;
    --text-secondary: #475569;
    --text-muted: #64748b;
    --text-faint: #94a3b8;
    --border: #e2e8f0;
    --border-strong: #cbd5e1;
    --success: #10b981;
    --warning: #f59e0b;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; scroll-padding-top: 80px; }

  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    background: var(--background);
    color: var(--text-primary);
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  ::selection { background: rgba(14, 165, 233, 0.22); }

  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }

  .page {
    max-width: 1440px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 0 clamp(20px, 5vw, 72px) 72px;
  }

  .section { padding-top: clamp(56px, 8vw, 88px); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }

  .section-head h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .section-sub {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .panel {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    transition: border-color 0.2s;
  }

  .panel:hover { border-color: var(--text-faint); }

  .tag {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 4px 8px;
    border-radius: 5px;
    background: transparent;
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: 7px; }

  .role-badge {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-strong);
    border: 1px solid var(--border);
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    color: #fff;
    background: var(--success);
  }

  .status-badge.progress { background: var(--warning); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: 14px;
    padding: 11px 18px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-primary);
    transition: border-color 0.2s, filter 0.2s;
  }

  .btn:hover { border-color: var(--accent); color: var(--text-primary); }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  .btn-primary:hover { filter: brightness(1.08); color: #fff; border-color: var(--accent); }

  @media (max-width: 640px) {
    .btn { padding: 10px 14px; font-size: 13.5px; }
  }
</style>

<script>
  // Highlight the nav link of the section currently in view
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
  const sections = links
    .map((l) => document.querySelector(l.getAttribute('href') ?? ''))
    .filter((s): s is Element => !!s);

  const update = () => {
    let current = '';
    for (const s of sections) {
      if (window.scrollY + 140 >= (s as HTMLElement).offsetTop) current = s.id;
    }
    links.forEach((l) => l.classList.toggle('active', l.getAttribute('href') === `#${current}`));
  };

  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
