---
import { Linkedin, Github, Mail, Download } from 'lucide-astro';
import { getLangFromUrl, useContent } from '../i18n/utils';
import { links } from '../data/portfolio';
import Badge from './icons/Badge.astro';

const lang = getLangFromUrl(Astro.url);
const c = useContent(lang);
---

<header id="top" class="hero">
  <div class="hero-text">
    <div class="hero-badge"><Badge>{c.hero.badge}</Badge></div>
    <h1>Álvaro Bernal</h1>
    <p class="role">{c.hero.role}</p>
    <p class="tagline">{c.hero.tagline}</p>
    <div class="actions">
      <a href={links.cv} class="btn btn-primary" target="_blank" rel="noopener">
        <Download size={16} />{c.hero.cv}
      </a>
      <a href={links.github} class="btn" target="_blank" rel="noopener"><Github size={16} />GitHub</a>
      <a href={links.linkedin} class="btn" target="_blank" rel="noopener"><Linkedin size={16} />LinkedIn</a>
      <a href={`mailto:${links.email}`} class="btn"><Mail size={16} />{c.hero.contact}</a>
    </div>
  </div>

  <figure class="photo-card">
    <div class="photo-bar">
      <span></span><span></span><span></span>
      <em>alvaro.bernal · St. Gallen, CH</em>
    </div>
    <img src="https://avatars.githubusercontent.com/u/80347035?v=4" alt={c.hero.photoAlt} />
  </figure>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--border);
  }

  .hero-badge { display: inline-block; }

  h1 {
    font-size: clamp(36px, 4.6vw, 60px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin-top: 24px;
  }

  .role {
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.45;
    color: var(--text-strong);
    margin-top: 20px;
    max-width: 36ch;
    text-wrap: pretty;
  }

  .tagline {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 16px;
    max-width: 50ch;
    text-wrap: pretty;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }

  .photo-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff, #f1f5f9);
    overflow: hidden;
    max-width: 230px;
    width: 100%;
    justify-self: center;
  }

  .photo-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    background: #ffffff;
  }

  .photo-bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }

  .photo-bar em {
    margin-left: 6px;
    font-style: normal;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .photo-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center top;
  }
</style>
