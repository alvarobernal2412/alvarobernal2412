---
import { Award, CheckCircle } from 'lucide-astro';
import { getLangFromUrl, useContent } from '../i18n/utils';
import { education, certifications } from '../data/portfolio';

const lang = getLangFromUrl(Astro.url);
const c = useContent(lang);
---

<section id="education" class="section">
  <div class="section-head">
    <h2>{c.education.title}</h2>
    <span class="section-sub">{c.education.sub}</span>
  </div>

  <div class="grid">
    {education.map((e, i) => (
      <div class="panel card">
        <div class="top">
          <span class="period">{e.period[lang]}</span>
          <span class:list={['status-badge', { progress: e.status === 'inProgress' }]}>
            {c.education[e.status]}
          </span>
        </div>
        <div class="icon"><Award size={22} /></div>
        <h3>{c.education.items[i].degree}</h3>
        <span class="school">{e.school}</span>
        <span class="focus">{c.education.items[i].focus}</span>
      </div>
    ))}
  </div>

  <div class="certs">
    <span class="certs-label">{c.education.certs}</span>
    {certifications.map((cert) => (
      <span class="cert">
        <CheckCircle size={14} />
        {cert.name} · {cert.year}
        <span class="status-badge">{c.education.certified}</span>
      </span>
    ))}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }

  .card { border-radius: 12px; padding: 22px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .period { font-family: var(--mono); font-size: 11.5px; color: var(--accent); }
  .icon { color: var(--accent-2); }
  h3 { font-size: 17px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty; }
  .school { font-size: 13.5px; color: var(--text-secondary); }
  .focus { font-size: 13.5px; color: var(--text-muted); line-height: 1.55; margin-top: auto; padding-top: 8px; text-wrap: pretty; }

  .certs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; align-items: center; }
  .certs-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }

  .cert {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 12px; color: var(--text-strong);
    border: 1px solid var(--border); background: var(--surface); padding: 6px 10px; border-radius: 6px;
  }
  .cert :global(svg) { color: var(--success); }
</style>
