---
import { getLangFromUrl, useContent } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const c = useContent(lang);

const items = [
  ['#work', c.nav.work],
  ['#artifact', c.nav.artifact],
  ['#experience', c.nav.experience],
  ['#publications', c.nav.publications],
  ['#projects', c.nav.projects],
  ['#education', c.nav.education],
];
---

<nav class="nav">
  <a href="#top" class="brand">
    <span class="pulse"></span>
    <span class="brand-name">alvaro.bernal</span><span class="brand-at">@hsg</span>
  </a>
  <div class="nav-links">
    {items.map(([href, label]) => <a href={href} class="nav-link">{label}</a>)}
    <LanguageSwitcher currentLang={lang} />
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 18px 0;
    background: rgba(248, 250, 252, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 13px;
  }

  .brand:hover { color: inherit; }
  .brand-name { color: var(--text-primary); }
  .brand-at { color: var(--text-muted); margin-left: -8px; }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: pulse 2.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .nav-link.active { color: var(--accent); }

  @media (max-width: 640px) {
    .nav-links { gap: 14px; font-size: 13px; }
  }
</style>
