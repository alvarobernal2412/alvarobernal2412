---
import { ChartCandlestick, Brain, Users, TrendingUp, Bot, Workflow, FlaskConical, MapPin } from 'lucide-astro';
import { getLangFromUrl, useContent } from '../i18n/utils';
import { experience } from '../data/portfolio';

const lang = getLangFromUrl(Astro.url);
const c = useContent(lang);
const icons = { ChartCandlestick, Brain, Users, TrendingUp, Bot, Workflow, FlaskConical };
---

<section id="experience" class="section">
  <div class="section-head">
    <h2>{c.experience.title}</h2>
    <span class="section-sub">{c.experience.sub}</span>
  </div>

  <div class="list">
    {experience.map((job, i) => {
      const text = c.experience.jobs[i];
      return (
        <div class="row">
          <div class="when">
            <span class="period">{job.period[lang]}</span>
            <span class="place">{job.place}</span>
            {job.logo && <img src={job.logo} alt={job.logoAlt} style={`height:${job.logoHeight}px`} />}
            {job.hybrid && (
              <span class="mode"><MapPin size={12} />{c.experience.hybrid}</span>
            )}
          </div>
          <div class="what">
            <div class="title-line">
              <h3>{text.title}</h3>
              <span class="role-badge">{text.badge}</span>
            </div>
            <p class="desc">{text.desc}</p>
            {text.achievements.length > 0 && (
              <div class="achievements">
                <h4>{c.experience.achievements}</h4>
                <ul>
                  {text.achievements.map((item, k) => {
                    const Icon = icons[job.icons[k] as keyof typeof icons];
                    return <li><Icon size={16} />{item}</li>;
                  })}
                </ul>
              </div>
            )}
            <div class="tag-row tags">{job.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(150px, 200px) minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    padding: 26px 0;
    border-top: 1px solid var(--border);
  }

  .when { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .period { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .place { font-family: var(--mono); font-size: 11.5px; color: var(--text-muted); }
  .when img { margin-top: 6px; width: auto; max-width: 100%; border-radius: 8px; object-fit: contain; }

  .mode {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--mono); font-size: 11px; color: var(--text-muted);
  }

  .what { min-width: 0; }
  .title-line { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  h3 { font-size: 19px; font-weight: 600; letter-spacing: -0.015em; }
  .desc { margin-top: 10px; color: var(--text-secondary); font-size: 14.5px; line-height: 1.65; max-width: 70ch; text-wrap: pretty; }

  .achievements { margin-top: 16px; }
  .achievements h4 {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-muted); font-weight: 500; margin-bottom: 10px;
  }
  ul { list-style: none; display: grid; gap: 8px; }
  li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--text-strong); line-height: 1.5; }
  li :global(svg) { flex: none; margin-top: 2px; color: var(--accent); }

  .tags { margin-top: 16px; }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
