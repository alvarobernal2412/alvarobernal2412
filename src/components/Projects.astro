---
import { ExternalLink, Github, Calendar, Users, TrendingUp, FileText } from 'lucide-astro';
import { getLangFromUrl, useContent } from '../i18n/utils';
import { projects } from '../data/portfolio';

const lang = getLangFromUrl(Astro.url);
const c = useContent(lang);
const statIcons = [Users, TrendingUp, Calendar];
---

<section id="projects" class="section">
  <div class="section-head">
    <h2>{c.projects.title}</h2>
    <span class="section-sub">{c.projects.sub}</span>
  </div>

  <div class="grid">
    {projects.map((p, i) => {
      const text = c.projects.items[i];
      return (
        <article class="panel card">
          <div class="content">
            <div class="head">
              <h3>{p.name}</h3>
              <span class="role-badge">{text.role}</span>
            </div>
            <p class="desc">{text.desc}</p>

            <div class="stats">
              {text.stats.map((s, k) => {
                const Icon = statIcons[k];
                return <span class="stat"><Icon size={14} />{s}</span>;
              })}
            </div>

            <div class="highlights">
              <h4>{c.projects.achievements}</h4>
              <ul>{text.achievements.map((a) => <li>{a}</li>)}</ul>
            </div>

            <div class="tag-row">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>

            <div class="links">
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener" aria-label={c.projects.viewProject} title={c.projects.viewProject}><ExternalLink size={18} /></a>
              )}
              <a href={p.source} target="_blank" rel="noopener" aria-label={c.projects.viewSource} title={c.projects.viewSource}><Github size={18} /></a>
              {p.thesis && (
                <a href={p.thesis} target="_blank" rel="noopener" aria-label={c.projects.viewThesis} title={c.projects.viewThesis}><FileText size={18} /></a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 16px; }

  .card { border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; min-width: 0; }
  .card:hover { border-color: var(--accent); }

  .content { padding: 22px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  h3 { font-family: var(--mono); font-size: 15px; font-weight: 500; color: var(--text-primary); }
  .desc { color: var(--text-secondary); font-size: 14px; line-height: 1.6; text-wrap: pretty; }

  .stats { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .stat { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-muted); }
  .stat :global(svg) { color: var(--accent); }

  .highlights h4 {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-muted); font-weight: 500; margin-bottom: 8px;
  }
  ul { list-style: none; display: grid; gap: 6px; }
  li { font-size: 13.5px; color: var(--text-strong); padding-left: 16px; position: relative; line-height: 1.5; }
  li::before { content: '›'; position: absolute; left: 0; color: var(--accent); font-family: var(--mono); }

  .tag-row { margin-top: auto; padding-top: 6px; }

  .links { display: flex; gap: 14px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 14px; }
  .links a:hover { color: var(--accent); }
</style>
